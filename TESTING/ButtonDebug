#include <Wire.h>
#include "Adafruit_DRV2605.h"
#include "Arduino.h"
#include "DFRobotDFPlayerMini.h"


Adafruit_DRV2605 drvQT; // Identifying DRV (LRA) 
DFRobotDFPlayerMini myDFPlayer; // Identifying DFPlayer (MP3 player)

// Keyfob receiver pins
const int ButtonB = 4; // D0 on receiver
const int ButtonD = 5; // D1 on receiver
const int ButtonA = 3; // D2 on receiver
const int ButtonC = 7; // D3 on receiver

const int magnet = 8; // Identifying the pin connecting to the magnet 
const uint8_t HAPTIC_EFFECT = 24; // Setting haptic effect on LRA 

bool lastA = false, lastB = false, lastC = false, lastD = false;
bool magnetON = false;
uint8_t distress = 0; // which case plays NEXT
bool dfReady = false;

// Non-blocking timer for turning the magnet off after LRA haptic
bool magnetOffPending = false;
unsigned long magnetOffAt = 0;

// Sleep mode initialization 
const unsigned long threshold = 500000UL; // 5 minute threshold before falling asleep
unsigned long LASTACTIVE = 0 ;


void magnetHIGH() { magnetON = true;  digitalWrite(magnet, HIGH); }
void magnetLOW()  { magnetON = false; digitalWrite(magnet, LOW);  }

//LRA initialization and set up
void initLRA() {
  drvQT.begin();
  drvQT.selectLibrary(6);      // LRA library
  drvQT.useLRA();
  drvQT.setMode(DRV2605_MODE_INTTRIG);
  drvQT.setWaveform(0, HAPTIC_EFFECT);
  drvQT.setWaveform(1, 0);     // end of sequence


  if (!drvQT.begin(&Wire1)) {
     Serial.println("Could not find QT DRV2605L");
   } else {
     Serial.println("QT DRV2605L found");
     drvQT.selectLibrary(6);
     drvQT.useLRA();
     drvQT.setMode(DRV2605_MODE_INTTRIG);
     drvQT.setWaveform(0, HAPTIC_EFFECT);
     drvQT.setWaveform(1, 0);
   }
}

void setup() {
  pinMode(ButtonA, INPUT);
  pinMode(ButtonB, INPUT);
  pinMode(ButtonC, INPUT);
  pinMode(ButtonD, INPUT);
  pinMode(magnet, OUTPUT);
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(magnet, LOW);

  Serial.begin(9600);
  Serial1.begin(9600);
  Wire.begin();
  delay(2000);

  initLRA();

  // Reset the DFPlayer (3rd arg true) and give it time to read the SD card
  if (!myDFPlayer.begin(Serial1, true, false)) {
    Serial.println("DFPlayer failed /:  check wiring, 1k resistor on Arduino TX, SD card");
  } else {
    dfReady = true;
    myDFPlayer.volume(30);
    delay(500);
  }

  LASTACTIVE = millis(); 
}

void loop() {
  bool a = digitalRead(ButtonA) == HIGH;
  bool b = digitalRead(ButtonB) == HIGH;
  bool c = digitalRead(ButtonC) == HIGH;
  bool d = digitalRead(ButtonD) == HIGH;

/*BUTTON DEBUG : If any button seems to not be working, attempt to run this section of the code.
This detects how long the button press was for in milliseconds. run with serial monitor open

 static bool prevB = false;
static unsigned long riseTime = 0;
if (b != prevB) {
  if (b) {
    riseTime = millis();
    Serial.println("B rise");
  } else {
    Serial.print("B fall, high for ");
    Serial.print(millis() - riseTime);
    Serial.println(" ms");
  }
  prevB = b;
}*/

  // A: magnet on
  if (a && !lastA) {
    magnetHIGH();
  }

  // B: cycle 1 -> 5 -> stop (this order, starting with track 1)
  if (b && !lastB && dfReady) {
    switch (distress) {
      case 0: myDFPlayer.play(4); break; //4
      case 1: myDFPlayer.stop(); break;
      case 2: myDFPlayer.play(9); break; 
      case 3: myDFPlayer.stop(); break;
        }
    distress = (distress + 1) % 4;
  }

  // C: haptic now, magnet off 2 seconds later (no blocking delay)
  if (c && !lastC) {
    drvQT.go();
    delay(20); 
    drvQT.stop();
    magnetOffPending = true;
    magnetOffAt = millis() + 2000;
  }

  if (magnetOffPending && (long)(millis() - magnetOffAt) >= 0) {
    magnetLOW();
    magnetOffPending = false;
    // Re-arm the drivers in case the magnet switching glitched the I2C bus / DRV
    initLRA();
  }
  if (d && !lastD && dfReady) {
    switch (distress) {
      case 0: myDFPlayer.play(3); break;
        }
    distress = (distress + 1) % 1;
  }

  if ((a && !lastA) || (b && !lastB) || (c && !lastC) || (d && !lastD)) {
  LASTACTIVE = millis();
}
//Sleep mode: temporarily deactivates CPU 
if (!magnetOffPending && (millis() - LASTACTIVE >= threshold)) {
  myDFPlayer.playMp3Folder(10);
  Serial.println("Goodnight!");
  Serial.flush();
  magnetLOW();
  if (dfReady) myDFPlayer.stop();

  digitalWrite(LED_BUILTIN, LOW);

  while (digitalRead(ButtonA) == LOW) {
    __WFI(); // CPU halts until the next interrupt
  }

  digitalWrite(LED_BUILTIN, HIGH);
  myDFPlayer.playMp3Folder(11);
  Serial.println("I'm awake!");
  LASTACTIVE = millis();
  a = true;                       // wake press is consumed, so it doesn't fire the magnet
  b = c = d = false;
  lastA = true;
} 

  lastA = a; lastB = b; lastC = c; lastD = d;
  delay(20);  // short loop so quick keyfob pulses aren't missed
}
